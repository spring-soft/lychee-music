# ESP-Music 强制配置（非敏感）
#
# 这个文件和 sdkconfig.local 走同一条路：configure 之前由 tools/sync_sdkconfig.py
# 覆盖进 sdkconfig。放这里的理由：**改 sdkconfig.defaults 对已生成的 sdkconfig
# 是无效的**（IDF 只在符号还没被赋值时才用 defaults），而这些开关又必须真的生效。
# 详见 sdkconfig.defaults 顶部与 tools/sync_sdkconfig.py 的说明。
#
# 与 sdkconfig.local 的分工：local 只放敏感值（密码/账号），本文件放开关。

# ===== M7 蓝牙遥控：把 BLE 的内存开销从内部 SRAM 挪走 =====
#
# 动机（2026-09-25 实测）：内部 SRAM 是这块板唯一紧的资源。
#   开机未播放          剩 50 KB
#   一播放就掉到        10~15 KB
#   （libaudio_engine 占 10 KB、JPEG 解码器 6.5 KB、解码器状态等，
#     都是运行时从内部堆拿的 —— 见 [[esp-music-m6-persistence]]）
# NimBLE + HID 大约要 40 KB 量级，出厂默认配置（内存全在内部）根本放不下。
#
# ⚠️ 下面两条是"能不能做成"的关键，不是调优。

# 1) NimBLE 主机的堆走 PSRAM（默认 INTERNAL）。
#    NimBLE 自己那套内存池（mbuf、属性表、连接上下文）是大头，占内部 SRAM 的话
#    起播后立刻见底。PSRAM 还有 6 MB 空着，主机侧访问不在 ISR 里，安全。
#    （控制器那部分不能这么办：它在 ISR/硬件路径上，必须留在内部 RAM。）
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# 2) 控制器只保留最少活动。每个 BLE "活动"（广播 / 扫描 / 连接）都要控制器 RAM。
#    我们的用途只是被手机/PC 连上做 HID 外设：1 条连接 + 1 个广播 = 2 够用。
#    出厂默认 6（同时还能当主设备去扫别人），这里用不上，白占内存。
CONFIG_BT_CTRL_BLE_MAX_ACT=2

# 3) 我们是外设、从不主动扫描，去重过滤缓存 100 条纯属浪费（默认值）。
CONFIG_BT_CTRL_SCAN_DUPL_CACHE_SIZE=10

# 4) 只做外设：广播 + 被连。不做 central/observer（sdkconfig.defaults 里已关，
#    但 default 对已生成的 sdkconfig 无效，这里再钉一遍）。
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# ===== 给蓝牙腾内部 SRAM（2026-09-25 实测：加 BLE 后内部 SRAM 掉到 0KB）=====
#
# 症状（加了 BLE 之后）：内部 SRAM 0KB / DMA 可用 0KB，连带三件事一起坏 ——
#   HTTP_CLIENT: Connection failed, sock < 0   （socket 分配不出来）
#   封面下载失败、流打不开
#   ui: lv_timer 最坏 0ms | 5 秒内刷新 0 次     （屏幕不刷新）
# 所以下面两条不是"调优"，是"能不能用"。

# 5) WiFi / LwIP 的缓冲优先放 PSRAM（放不下才退回内部 RAM）。
#    这是最大的一笔：WiFi RX/TX 缓冲 + LwIP 的 pbuf/PCB 加起来几十 KB，
#    全在内部 RAM 的话蓝牙一来就没了。官方选项，失败会自动退回内部。
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# 6) ⚠️ 顺手修一个【潜伏的 bug】：lwIP 的 socket 上限是全局的，httpd 要
#    max_open_sockets+3 个（我们配 6 → 9），再加音频流 1 个 + 元数据 1 个 = 11。
#    sdkconfig.defaults 里早就写了 16，但**实际生效的是 10** ——
#    又是"defaults 对已生成的 sdkconfig 无效"那个坑（见 [[esp-music-sdkconfig-local-trap]]）。
#    症状就是上面那条 `sock < 0`，以及之前查到过的周期性 1 秒 TCP 重传尖峰。
CONFIG_LWIP_MAX_SOCKETS=16

# 7) ⚠️ TCP 窗口/SND 缓冲是【每条连接】的，这是 WiFi 连上后吃掉 86KB 内部
#    SRAM 的主因（音频流 + 元数据 + 网页轮询同时开着）。16KB 是从 5.7KB 提上来的
#    （当时那个网络 RTT 66~164ms，小窗口要 11 个来回），但现在 RSSI -23、
#    局域网近在咫尺，8KB 够用。省下来的差不多是每连接 8KB。
CONFIG_LWIP_TCP_WND_DEFAULT=8192
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=8192

# 8) WiFi 的【静态】RX 缓冲必须是内部 RAM（DMA），8 个约 13KB。
#    降到 4 个：动态 RX 池（走 PSRAM）还在，突发时能兜住。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4

# 9) WiFi 的 IRAM 代码挪回 flash（换取内部 SRAM）
#
#    `libpp.a` / `libnet80211.a` 里有大约 15KB 是常驻 IRAM 的收包快路径代码。
#    关掉这两个选项让它们从 flash 跑（XIP，走 cache）—— 内部 SRAM 多出这一截，
#    代价只是 WiFi 收包略慢。对这个用途完全够：音频流只有 192kbps ≈ 24KB/s，
#    即使全走 cache miss 也富余得多。
#    ⚠️ 这是"最后一截余量"：加 BLE 后实测只剩 4KB，WiFi 扫描/歌词/网页这些
#    临时分配一旦碰到不够就是 abort 重启（lwIP 的信号量都分不出来）。
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# ===== M8：LVGL 控件不该占内部 RAM =====
#
# 症状（2026-09-25 加搜索页后）：新页面有 ~67 个 LVGL 控件（字母格一个字母一个标签），
# 每个约 200~250 字节，于是内部 SRAM 又被吃光：
#   E BLE_INIT: Malloc failed
#   E httpd_accept_conn: error in accept (113)
#
# 根因是这条：**小于 4KB 的 malloc 一律放内部 RAM**。LVGL 控件树完全不需要内部 RAM
# （它不是 DMA 目标 —— 真正要 DMA 的是画布，那两个缓冲是显式 MALLOC_CAP_DMA|INTERNAL
# 申请的，不受这条影响）。
#
# 降到 512：只有很小的分配还留在内部，控件/样式/小结构体都进 PSRAM（还剩 6MB）。
# 代价是 LVGL 遍历控件树时多走外部 RAM，但实测 lv_timer 最坏 7~16ms，有余量。
# ⚠️ 这条不是"调优"：不降的话 BLE 直接起不来。
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512

# ===== 音乐库里有 99 个 OGG，打开 Vorbis 解码器让它们直出 =====
#
# 背景：曲库 781 首里 681 个 FLAC（已直出）、**99 个 Ogg/Vorbis**、1 个 m4a。
# OggS 的格式嗅探早就有了（audio_engine.c 认魔数），唯独解码器没编进来 ——
# 于是这 99 首只能让服务端转成 MP3 192k，在 Vorbis 本身的损失上【再叠一层 MP3 损失】。
#
# 试过的另一条路走不通：让服务端转 FLAC。两个理由 ——
#   1) Navidrome 的转码配置里【没有 flac 这一档】，实测请求 format=flac 会被
#      退回成"直接发原文件"（返回的还是 OggS，不是 FLAC）。
#   2) 就算支持也不划算：Vorbis 本来就是有损，转 FLAC 只是把有损结果原样存成
#      无损（音质上限不变），而且 FLAC 比原 OGG 还大 50%+，纯白费 WiFi 带宽。
#
# 直接解 Vorbis 才是正解：原文件原样、零额外损失、带宽最省、服务器零负担。
# 全部 99 个文件实测确认是 Vorbis（不是 Opus/FLAC 装在 Ogg 里），所以不需要开 Opus。
CONFIG_AUDIO_DECODER_VORBIS_SUPPORT=y

# ===== 补齐其余【音乐类】解码器，目标是插 TF 卡时绝大多数格式都能本地解 =====
#
# 这个组件能提供的解码器一共 14 个，按"音乐文件会不会用到"分两类：
#
#   ✅ 开（音乐文件常见）：
#      MP3 / FLAC / AAC / PCM  —— 本来就有（CONFIG_AUDIO_DECODER_*_SUPPORT）
#      VORBIS                  —— 见上，曲库 99 首 Ogg
#      OPUS                    —— Ogg 里装 Opus 的越来越多；也是 Navidrome 不带
#                                 format 时的默认转码目标（本工程显式给了 format 才避开）
#      ALAC                    —— Apple 无损，装在 m4a 里。开了它 m4a 才两种编码通吃
#      ADPCM                   —— 少数 WAV 用它
#
#   ❌ 不开（语音/蓝牙编码，音乐文件不会有）：
#      G711 / G722（电话）、AMRNB / AMRWB（手机录音）、SBC / LC3（蓝牙传输）
#      开了只是白白增加 .text 和格式嗅探时的误判面，没有任何文件会命中。
#
# ⚠️ 能力边界（组件里【根本没有】这些解码器，开了配置也解不了）：
#      WMA、APE(Monkey's Audio)、DSD/DSF
#    联网时还能靠服务端转码绕过；**脱机插 TF 卡时这些格式就是放不了**，别再找开关。
CONFIG_AUDIO_DECODER_OPUS_SUPPORT=y
CONFIG_AUDIO_DECODER_ALAC_SUPPORT=y
CONFIG_AUDIO_DECODER_ADPCM_SUPPORT=y

# ===== 放大 TCP 接收窗口：直出无损后吞吐不够了 =====
#
# 2026-10-01 实机踩到：播 FLAC（源 24bit/44.1k，文件码率 1576kbps ≈ 197 KB/s）时，
# 网络取流稳定在 179~180 KB/s —— 【正好差一点点】，缓冲被一路抽干，
# 4 分钟里攒了 33 次欠载。
#
# 根因不是 WiFi 不行（RSSI -56dBm、信道干净），是 **TCP 接收窗口太小**：
#     吞吐 ≈ 窗口 ÷ 往返延迟
# 默认窗口 CONFIG_LWIP_TCP_WND_DEFAULT=8192，按 RTT 45ms 算就是 182 KB/s
# —— 和实测的 179~180 几乎一模一样。
#
# 提到 32768（4 倍）→ 同条件下上限约 700 KB/s，对 197 KB/s 的 FLAC 有 3 倍余量。
#
# ⚠️ 窗口内存不占内部 SRAM：CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y 已经开着，
#    WiFi/lwIP 的分配会先走 PSRAM（现在还有 5.2MB 空闲）。别把那条关掉，
#    关了以后这个窗口会把内部 SRAM（只剩 13KB）撑爆。
CONFIG_LWIP_TCP_WND_DEFAULT=65535
# 发送方向也放大：HTTP 请求本身很小，但确认包走同一条路，SND_BUF 太小会拖慢窗口推进
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768

# ===== WiFi 接收缓冲：从省 SRAM 的保守值调回接近默认 =====
#
# 2026-10-01 实机定位：ESP32 拉流稳定在 **100~130 KB/s（约 1Mbps）**，
# 而同一台服务器、同一个局域网，电脑能拉到 **4101 KB/s** —— 服务器和 LAN 都没问题，
# 瓶颈是 WiFi 接收缓冲。
#
# 原因：这两条被砍到默认值的 40%（默认 10 / 32）：
#     ESP_WIFI_STATIC_RX_BUFFER_NUM=4
#     ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
# 16 × 1.6KB ≈ 26KB 的接收缓冲，**TCP 窗口开再大也填不满**（这就是为什么前面
# 把 TCP_WND 提到 32KB 并没有真正提上去 —— 那个改动的验证是撞上了一首低码率的歌，
# 网络刚好配得上，看起来像成功）。
#
# 这不是原作者疏忽，是**为省内部 SRAM 给 BLE 让路**的有意取舍（BLE 要 40KB）。
# 所以这一条是"把吞吐换回来"，代价是内部 SRAM —— 开机日志里会看到余量掉多少，
# 如果掉到 0 或 BLE 起不来，就把这两条调回去，改用"按码率决定要不要直出"的策略。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
# 接收方向的块确认窗口：默认 6 —— 太小，AMPDU 聚合不起来，吞吐上不去。
# 实测把它和其他缓冲一起放大后，峰值从 ~100 KB/s 提到 194 KB/s。
# 上限受 DYNAMIC_RX_BUFFER_NUM 约束（要 ≤ 它），48 配 16 是安全组合。
CONFIG_ESP_WIFI_RX_BA_WIN=32
# 发送方向同理由（HTTP 请求本身很小，但确认包走同一条路）
CONFIG_ESP_WIFI_TX_BA_WIN=32
# lwIP 的接收邮箱：段到达时先投这里，太小会丢段 → TCP 重传 → 吞吐掉。
# TCPIP 那个是跨线程邮箱（WiFi 任务 → TCP/IP 任务），整机只有一份，加大最划算。
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

# ===== 关掉 BLE，把内部 SRAM 让给 WiFi（2026-10-01 用户拍板）=====
#
# 直出无损要持续 ~200 KB/s，而 WiFi 的接收缓冲是 DMA 目标，**必须在内部 SRAM**。
# 原先只敢配 4/16（默认 10/32），就是被 BLE 的 ~40KB 逼的。
#
# 关掉之后把 RX 缓冲放到 8/48 + BA 窗口 16，实测峰值吞吐 ~100 → ~194 KB/s。
#
# 代价：K4 的"蓝牙控制"页显示"不可用"（hid_remote.c 在 !CONFIG_BT_ENABLED 时
# 编成空实现，UI 侧不用改，功能优雅降级）。
#
# 要恢复蓝牙遥控：删掉下面这行即可 —— hid_remote.c 和它的 CMakeLists 都按
# CONFIG_BT_ENABLED 条件编译，不需要改任何代码。
#
# ⚠️ 恢复 BLE 后 WiFi 缓冲会被重新挤小，高码率 FLAC 会重新开始卡；
#    那时应该同时把 subsonic.c 里的 DIRECT_PLAY_MAX_KBS 调低。
CONFIG_BT_ENABLED=n

# ===== 板型：本分支固定为【面包板】=====
#
# 2026-10-07 起面包板与 PCB 拆成两条 git 分支，各自把板型【钉死】在这里，
# 于是每条分支都自洽，不再依赖 sdkconfig.local（那是 gitignore 的、含密码的文件）：
#
#   breadboard 分支 → CONFIG_BOARD_VARIANT_BREADBOARD=y   ← 本行
#   v2-pcb     分支 → CONFIG_BOARD_VARIANT_BREADBOARD=n
#
# 为什么必须钉死（这是"两条分支真正互不干扰"的关键）：
#   sync_sdkconfig.py 先应用 sdkconfig.local、再应用本文件，所以这里能压过 local。
#   否则 local 里残留的一行板型会让"面包板分支编出 PCB 固件"——而那种错误**不报错**，
#   只能靠"K1 按了没反应"这种现象去发现（K1 在面包板是 GPIO3、在 V2 是 GPIO38）。
#
# ⚠️ 换了这一行必须 fullclean 再编（引脚宏影响多个组件的条件编译）。
CONFIG_BOARD_VARIANT_BREADBOARD=y
