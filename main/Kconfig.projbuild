menu "ESP-Music 配置"

    config BOARD_VARIANT_BREADBOARD
        bool "板型 = 面包板（默认是自制 PCB V2）"
        default n
        help
            只用一个 bool 而不是 Kconfig choice —— 因为 tools/sync_sdkconfig.py 是
            【按行覆盖】的，对 choice 会留下"两个选项都是 y"的矛盾状态。

            两块板只有 3 个引脚不同，其余完全一样（详见 components/board/include/board.h）：

              引脚        面包板（开发板+音频模块）   自制 PCB V2
              I2S_DIN     GPIO38（录音回读）          不接（ADC 断电，只发不收）
              PA_EN       GPIO47（PAM8406 使能）      不接（无功放，耳放直推耳机）
              KEY1        GPIO3（strapping 脚）       GPIO38（避开 strapping）

            ⚠️ 换板型后请 `idf.py fullclean` 再编译 —— 引脚宏影响多个组件的条件编译，
               增量编译容易留下旧目标文件。

    config BOARD_FORCE_ENCODER
        bool "面包板上也启用旋转编码器（仅调试用）"
        default n
        help
            编码器与 TF 卡的开关【不】各自做成 Kconfig bool，而是由板型在
            board.h 里派生：
              面包板（BOARD_VARIANT_BREADBOARD=y） → 两个都不编译
              自制 PCB V2                          → 两个都编译

            为什么不用独立开关：sdkconfig 里一旦写进过值，Kconfig 的 default
            就不会再跟着板型重新求值 —— 换了板型必然留下"面包板变体 +
            硬件开关=开"这种自相矛盾的状态。这个工程已经在这条路上踩过一次
            （见 sdkconfig.forced 顶部关于 SDKCONFIG_DEFAULTS 的说明）。

            ⚠️ 只能用 sdkconfig.local 覆盖（sdkconfig.forced 是静态的，没法按板型分支）：
               临时在面包板上接一个 EC11 模块先把编码器逻辑跑通时，加一行
               CONFIG_BOARD_FORCE_ENCODER=y

    config BOARD_FORCE_TF
        bool "面包板上也启用 TF 卡（仅调试用）"
        default n
        help
            同上。面包板上临时接 microSD 模块时，往 sdkconfig.local 里加
            CONFIG_BOARD_FORCE_TF=y。

            ⚠️ 驱动用的仍是 V2 的引脚 IO12/CS、IO13/MISO、IO14/CD，而屏幕占着
               IO4/CLK 与 IO5/MOSI —— 两者共用 SPI2，接线时别撞车。

    config APP_WIFI_SSID
        string "WiFi SSID（仅作首次开机的 NVS 默认值）"
        default ""
        help
            留空表示不带默认凭据，由网页/串口配置。
            实际运行值优先从 NVS(namespace "net", key "ssid"/"pass") 读，
            NVS 里没有才用这里的默认值。敏感值建议放 sdkconfig.local。

    config APP_WIFI_PASSWORD
        string "WiFi 密码"
        default ""

    config APP_WIFI_HOSTNAME
        string "主机名（mDNS 用）"
        default "esp-music"

    menu "Navidrome 音乐源"

        config APP_NAV_HOST
            string "服务器地址（含 http:// 与端口）"
            default ""

        config APP_NAV_USER
            string "账号"
            default ""

        config APP_NAV_PASS
            string "密码"
            default ""

        config APP_NAV_TRANSCODE
            string "转码格式（auto / mp3 / aac / raw）"
            default "auto"
            help
                auto（推荐）= 首次播放时【直出原文件】（服务端不转码，音质最好），
                             只有 seek 时才让服务端转码（因为 raw 流不吃 timeOffset）。
                             仅当源是 mp3/flac 才直出，其余后缀（m4a/ogg/wma…）自动转码。
                mp3 / aac   = 永远转码。⚠️ 必须显式给 format：只给 maxBitRate 时
                             Navidrome 默认给 Opus，ESP32 上解码开销大。
                raw         = 永远直出（连 seek 也直出，但 seek 会失效）。

                ⚠️ FLAC 直出会丢最后一个 block（约 89ms）：流式 FLAC parser 需要
                   "下一帧同步字"来定帧边界，末尾没有下一帧就冲不出来。MP3 直出一帧不差。

        config APP_NAV_MAX_KBPS
            int "转码码率上限（kbps）"
            default 192
            range 64 320

    endmenu

    menu "QQ 音乐（自建契约层服务）"

        config APP_QQ_HOST
            string "契约层服务地址（含 http:// 与端口）"
            default "http://192.168.0.116:3210"
            help
                这是把 QQ 音乐包装成一套我们自己的 /v1/* 契约的服务。
                ⚠️ 2026-10-14 改：它**已经从 PC 上的 Docker 搬到了 OpenStick 棒子上**
                   （Qualcomm MSM8916 / Debian，systemd + venv 部署，源码在
                     github.com/spring-soft/lychee-music-qqservice）。PC 上那个已停用，
                   所以旧默认值 192.168.0.108 在新布局下连不上。
                地址也可以之后在网页设置里改（存 NVS，优先于这里的默认值）。
                ⚠️ 结尾不要带斜杠。

    endmenu

    config APP_M2_TEST_URL
        string "M2 联调用的测试音频 URL"
        default ""
        help
            M2 阶段先用本机 python3 -m http.server 验证 HTTP 流式拉取链路。
            配好 Navidrome 后可留空。

endmenu
